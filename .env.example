# =================================================================================================
# Configuración del Asistente de Estándares. Copia este archivo como ".env" y pon TUS claves.
# Formato: NOMBRE=valor, sin comillas ni espacios alrededor del "=". Vacío = valor por defecto.
# .env está en .gitignore: nunca lo subas al repositorio ni lo pegues en un chat o correo.
# Mantén este archivo y .env con las MISMAS variables (tests/test_config.py lo verifica).
# =================================================================================================

# --- 1. Proveedores --------------------------------------------------------------------------------
# LLM del chat, la reformulación y el agente:  anthropic (Claude) | openai | mock (sin red ni costo)
# Cambiar de LLM NO requiere re-indexar: el índice depende solo del proveedor de embeddings.
LLM_PROVIDER=anthropic
# Embeddings del índice: openai | hash (sin red, para pruebas). Anthropic no ofrece embeddings.
# Cambiar de embeddings SÍ requiere re-indexar (python -m app.ingesta) y recalibrar (python -m eval.evaluar).
EMBEDDINGS_PROVIDER=openai

# --- 2. Claude (Anthropic) · se usa si LLM_PROVIDER=anthropic · platform.claude.com → API Keys --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Profundidad del razonamiento y costo: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Respaldo automático si Claude rechaza una solicitud por seguridad (vacío = desactivado)
ANTHROPIC_FALLBACK=default
ANTHROPIC_TIMEOUT_S=120
ANTHROPIC_MAX_TOKENS=16000

# --- 3. OpenAI · embeddings siempre que EMBEDDINGS_PROVIDER=openai; LLM si LLM_PROVIDER=openai -------
# platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Solo si LLM_PROVIDER=openai. Revisa los modelos vigentes en platform.openai.com/docs/models
OPENAI_MODEL=gpt-5.4-mini
# Solo modelos de razonamiento de OpenAI: low | medium | high (vacío = no se envía)
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_S=60
OPENAI_MAX_OUTPUT_TOKENS=3000

# --- 4. Búsqueda (RAG) y router ---------------------------------------------------------------------
# Calibrados con python -m eval.evaluar (2026-11-01, text-embedding-3-small): hit@5 0.97, abstención 1.0,
# router 1.0. Si cambias de embeddings, déjalos vacíos (usa el valor por defecto) y recalibra.
RAG_MIN_SCORE=0.375
ROUTER_MIN_SCORE=0.35
# Reglas que recibe el LLM por respuesta
RAG_TOP_K=5
# Mensajes previos que recuerda el chat (memoria acotada: más memoria = más costo y más ruido)
HISTORIAL_MAX=6

# --- 5. Aplicación ----------------------------------------------------------------------------------
# 127.0.0.1 = solo este equipo. 0.0.0.0 = visible en la red (necesario para Prometheus en Docker).
HOST=127.0.0.1
PORT=8000
# Mensajes por minuto por equipo (límite de tasa; responde 429)
LIMITE_POR_MINUTO=30
# Tamaño máximo del código a validar (caracteres)
MAX_CARACTERES_CODIGO=15000

# --- 6. Rutas de datos (vacío = carpeta data/ del proyecto) -----------------------------------------
PDF_DIR=
REGISTRO_PATH=
INDICE_PATH=
DB_PATH=
TRAZAS_PATH=

# --- 7. Costos (USD por millón de tokens) para la métrica de costo. Verifica los precios vigentes. --
PRECIO_ANTHROPIC_INPUT=4
PRECIO_ANTHROPIC_OUTPUT=20
PRECIO_OPENAI_INPUT=0
PRECIO_OPENAI_OUTPUT=0
PRECIO_OPENAI_EMBEDDINGS=0.02
